{{!
    @template theme_epure/shortcuts

    Help of the keyboard shortcuts: a window that lists the shortcuts of the page by group, each with its keys (on a
    Mac, their symbols), and a box to turn off the key « ? » (WCAG 2.1.4).

    Example context (json):
    {
        "groups": [{"id": "epure-shortcuts-group-0", "title": "On every page", "items": [
            {"keys": [{"name": "?", "mac": "", "first": true, "either": false}], "action": "Open this help"},
            {"keys": [{"name": "Ctrl", "mac": "⌘", "first": true, "either": false},
                {"name": "K", "mac": "", "first": false, "either": false}],
                "action": "Open the quick search"}
        ]}],
        "keyenabled": true,
        "loggedin": true
    }
}}
<dialog class="epure-shortcuts" id="epure-shortcuts" aria-labelledby="epure-shortcuts-title" data-loggedin="{{#loggedin}}1{{/loggedin}}{{^loggedin}}0{{/loggedin}}">
    <div class="epure-shortcuts-head">
        <h2 class="epure-shortcuts-title" id="epure-shortcuts-title" tabindex="-1">{{#str}}shortcuts, theme_epure{{/str}}</h2>
        <button type="button" class="btn btn-secondary epure-shortcuts-close" data-action="epure-shortcuts-close">{{#str}}closebuttontitle, core{{/str}}</button>
    </div>
    {{#groups}}
        <table class="epure-shortcuts-table" aria-labelledby="{{id}}">
            <caption class="epure-shortcuts-group" id="{{id}}">{{title}}</caption>
            <thead class="sr-only visually-hidden">
                <tr><th scope="col">{{#str}}shortcuts_keys, theme_epure{{/str}}</th><th scope="col">{{#str}}shortcuts_action, theme_epure{{/str}}</th></tr>
            </thead>
            <tbody>
                {{#items}}
                    <tr>
                        <td class="epure-shortcuts-keys">{{#keys}}{{^first}}{{#either}} {{#str}}shortcuts_or, theme_epure{{/str}} {{/either}}{{^either}} <span aria-hidden="true">+</span> {{/either}}{{/first}}<kbd{{#mac}} data-mac="{{mac}}"{{/mac}}>{{name}}</kbd>{{/keys}}</td>
                        <td>{{action}}</td>
                    </tr>
                {{/items}}
            </tbody>
        </table>
    {{/groups}}
    <div class="form-check epure-shortcuts-switch">
        <input type="checkbox" class="form-check-input" id="epure-shortcuts-key" data-action="epure-shortcuts-key" aria-describedby="epure-shortcuts-key-help"{{#keyenabled}} checked{{/keyenabled}}>
        <label class="form-check-label" for="epure-shortcuts-key">{{#str}}shortcuts_key, theme_epure{{/str}}</label>
        <p class="epure-shortcuts-help" id="epure-shortcuts-key-help">{{#str}}shortcuts_key_help, theme_epure{{/str}}</p>
    </div>
</dialog>
