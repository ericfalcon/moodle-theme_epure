{{!
    @template theme_epure/quiz_progress

    How many questions of a quiz attempt are answered, above the buttons of the panel of the questions. The words say
    it all; the bar repeats them for the eyes.

    Example context (json):
    {
        "text": "3 of 10 questions answered",
        "percent": 30,
        "done": false
    }
}}
<div class="epure-quiz-progress{{#done}} epure-quiz-progress-done{{/done}}">
    <p class="epure-quiz-progress-text">{{#done}}<i class="icon fa fa-circle-check fa-fw" aria-hidden="true"></i>{{/done}}{{text}}</p>
    <div class="epure-quiz-progress-bar" aria-hidden="true"><span style="width: {{percent}}%"></span></div>
</div>
