{{!
    @template theme_epure/mycourses

    The « My courses » page of Épure: the courses the user teaches and the courses the user
    takes, in two sections, with a search and filters by status.

    Context variables required for this template:
    * hascourses, showheadings
    * filters - value, label, selected
    * sections - role, title, count, courses (see theme_epure/mycourses_card); for the courses the user teaches,
      teachingview, cardsview, tableview, hascompletioncolumn and downloadselector (HTML) (see theme_epure/mycourses_table)

    Example context (json):
    {
        "hascourses": true, "showheadings": true, "catalogueurl": "#",
        "filters": [{"value": "all", "label": "All", "selected": true}],
        "sections": [{"role": "learning", "title": "Courses I take", "count": 1, "courses": [{
            "id": 2, "name": "Safety", "url": "#", "image": "", "category": "Training", "status": "inprogress",
            "teaching": false, "rolename": "Student", "hasprogress": true, "progress": 40, "action": "Continue", "actionurl": "#"
        }]}]
    }
}}
<div class="epure-mycourses" data-region="epure-mycourses">
    {{#hascourses}}
        <div class="epure-mycourses-toolbar">
            <div class="epure-mycourses-search">
                <label class="sr-only visually-hidden" for="epure-mycourses-search">{{#str}}mycourses_search, theme_epure{{/str}}</label>
                <span class="epure-mycourses-search-icon" aria-hidden="true"><i class="fa fa-search"></i></span>
                <input type="search" class="form-control" id="epure-mycourses-search" data-action="search"
                    placeholder="{{#str}}mycourses_search, theme_epure{{/str}}" autocomplete="off">
            </div>
            {{#downloadcerts}}
                <a class="btn btn-secondary epure-mycourses-certificates" href="{{downloadcerts}}">
                    <i class="fa fa-download" aria-hidden="true"></i> {{#str}}mycourses_downloadcertificates, theme_epure{{/str}}
                </a>
            {{/downloadcerts}}
            <div class="epure-mycourses-filters" role="group" aria-label="{{#str}}mycourses_filter, theme_epure{{/str}}">
                {{#filters}}
                    <button type="button" class="epure-mycourses-filter" data-filter="{{value}}"
                        aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                {{/filters}}
            </div>
        </div>
        <p class="sr-only visually-hidden" aria-live="polite" data-region="status"></p>

        {{#sections}}
            <section class="epure-mycourses-section" data-role="{{role}}" {{#showheadings}}aria-labelledby="epure-mycourses-{{role}}"{{/showheadings}}>
                {{#showheadings}}
                    <h2 class="epure-mycourses-section-title" id="epure-mycourses-{{role}}">
                        {{title}} <span class="epure-mycourses-count" data-region="count">{{count}}</span>
                    </h2>
                {{/showheadings}}
                {{#teachingview}}
                    <div class="epure-mycourses-viewbar">
                        <div class="epure-mycourses-views" role="group" aria-label="{{#str}}mycourses_view, theme_epure{{/str}}">
                            <button type="button" class="epure-mycourses-viewbutton" data-view="cards"
                                aria-pressed="{{#cardsview}}true{{/cardsview}}{{^cardsview}}false{{/cardsview}}">
                                <i class="fa fa-grip" aria-hidden="true"></i>{{#str}}mycourses_viewcards, theme_epure{{/str}}
                            </button>
                            <button type="button" class="epure-mycourses-viewbutton" data-view="table"
                                aria-pressed="{{#tableview}}true{{/tableview}}{{^tableview}}false{{/tableview}}">
                                <i class="fa fa-table" aria-hidden="true"></i>{{#str}}mycourses_viewtable, theme_epure{{/str}}
                            </button>
                        </div>
                        <div class="epure-mycourses-download" data-region="download" {{^tableview}}hidden{{/tableview}}>{{{downloadselector}}}</div>
                    </div>
                {{/teachingview}}
                <ul class="epure-mycourses-grid" data-region="cards" {{#tableview}}hidden{{/tableview}}>
                    {{#courses}}
                        <li class="epure-mycourses-item" data-status="{{status}}" data-name="{{sortname}} {{category}}">
                            {{> theme_epure/mycourses_card }}
                        </li>
                    {{/courses}}
                </ul>
                {{#teachingview}}{{> theme_epure/mycourses_table }}{{/teachingview}}
                <p class="epure-mycourses-empty" data-region="empty" hidden>{{#str}}mycourses_nomatch, theme_epure{{/str}}</p>
            </section>
        {{/sections}}
    {{/hascourses}}
    {{^hascourses}}
        {{< theme_epure/empty_state }}
            {{$icon}}fa-solid fa-graduation-cap{{/icon}}
            {{$title}}{{#str}}empty_mycourses, theme_epure{{/str}}{{/title}}
            {{$text}}{{#str}}empty_courses, theme_epure{{/str}}{{/text}}
            {{$actions}}<a class="btn btn-primary" href="{{catalogueurl}}">{{#str}}empty_catalogue, theme_epure{{/str}}</a>{{/actions}}
        {{/ theme_epure/empty_state }}
    {{/hascourses}}
</div>
