                                <legend class="epure-a11yguide-checks-title">{{#str}}courseaccessibility_fix_links_title, theme_epure{{/str}}</legend>
                                {{#fixlinks}}
                                    <div class="epure-a11yguide-alt">
                                        <div class="epure-a11yguide-alt-fields">
                                            <label for="{{id}}">{{label}}</label>
                                            <input type="text" class="form-control" id="{{id}}" name="linktext[{{key}}]" maxlength="{{altmax}}" aria-describedby="{{id}}-help">
                                            <p class="epure-a11yguide-check-help" id="{{id}}-help">{{#str}}courseaccessibility_fix_links_help, theme_epure{{/str}}</p>
                                        </div>
                                    </div>
                                {{/fixlinks}}
                            </fieldset>
                        {{/hasfixlinks}}
                        {{#hasfixurllinks}}
