{{!
    @template theme_epure/course_accessibility

    Guide « Accessibility of the course », for its teachers: the figures of the course, then each section with the
    parts of the course that hold something to fix or to confirm. The points found without a person are listed with
    what to do and a link to change the part, a name, the images, frames, links, tables, titles and colours to correct here; the points to confirm are boxes, confirmed for all the teachers of the
    course with one button. Printed, it is the report of the course, without its buttons.

    Example context (json):
    {
        "reporttitle": "Accessibility of « Safety at work » on 05/11/26", "action": "#", "download": "", "sesskey": "abc", "checklisturl": "#", "courseurl": "#",
        "summary": "3 points to fix, 1 to confirm", "score": 70, "scoretext": "Accessibility score of the course: 70 %",
        "levels": [{"level": "blocking", "count": 1, "text": "Blocking: 1"}], "hasfirst": true,
        "first": [{"name": "Risks", "section": "Week 1", "url": "#epure-a11y-cm-4", "here": true}], "hasfilter": true,
        "filtershown": "Parts shown: {$a}", "filters": [{"value": "", "label": "All", "checked": true}], "done": "5 parts out of 8 have nothing left", "percent": 62,
        "hastoconfirm": true, "hasform": true, "savelabel": "Save the confirmations",
        "sections": [{"name": "Week 1", "id": "epure-a11y-section-1", "parts": [{
            "id": "epure-a11y-cm-4", "name": "Risks", "icon": "", "type": "Page",
            "state": {"class": "issues", "icon": "fa-triangle-exclamation", "text": "2 points to fix, 1 to confirm"},
            "hasissues": true, "issues": [{"text": "Images without a text alternative: 2. Describe each one.", "cause": "Images without a text alternative: 2.", "advice": "Describe each one.", "level": "blocking", "levellabel": "Blocking"}], "levels": "blocking", "level": "blocking",
            "hasplaces": true, "places": [{"label": "Chapter « Settings »", "sep": ": ", "issues": "2 images used as links",
                "url": "#", "linktext": "Change chapter « Settings »"}],
            "altmax": 250, "hasfixframes": true, "fixframes": [{"id": "epure-a11y-cm-4-frames-0", "key": "page-content-4-0-abc", "label": "Title of the frame « youtube.com/embed/abc »"}],
            "hasfixtables": true, "fixtables": [{"id": "epure-a11y-cm-4-tables-0", "key": "page-content-4-0-def", "label": "The first row of this table is its header: « Name | Date »"}],
            "hasfixlinks": true, "fixlinks": [{"id": "epure-a11y-cm-4-links-0", "key": "page-content-4-0-ghi", "label": "New text of the link to « example.org » (now « click here »)"}],
            "hasfixheadings": true, "fixheadings": [{"id": "epure-a11y-cm-4-headings-0", "key": "page-content-4-0-jkl", "label": "Put the titles of this text in order: levels 2, 4 become 2, 3"}],
            "hasrename": true, "rename": {"id": "epure-a11y-cm-4-rename", "field": "rename", "cmid": 4, "value": "Risks", "label": "New name of « Risks » (Week 1)", "help": "A name a learner understands."},
            "haschecks": true, "checks": [{"name": "4|captions:abc", "id": "epure-a11y-check-cm-4-0",
                "label": "The video « youtube.com » has subtitles", "help": "Subtitles let the deaf follow.",
                "checked": false}],
            "links": [{"url": "#", "text": "Change « Risks »"}]
        }]}]
    }
}}
<div class="epure-a11yguide">
    <p class="epure-a11yguide-print-title d-none d-print-block">{{reporttitle}}</p>
    <p class="epure-a11yguide-intro">{{#str}}courseaccessibility_intro, theme_epure{{/str}}</p>

    <div class="epure-a11yguide-summary">
        <p class="epure-a11yguide-score">{{scoretext}}</p>
        <div class="epure-a11yguide-bar" aria-hidden="true"><span style="width: {{score}}%"></span></div>
        <ul class="epure-a11yguide-levels">
            {{#levels}}<li class="epure-a11yguide-level epure-a11yguide-level-{{level}}">{{text}}</li>{{/levels}}
        </ul>
        <p class="epure-a11yguide-summary-text">{{summary}} · {{done}}</p>
        <p class="epure-a11yguide-help d-print-none">{{#str}}courseaccessibility_score_help, theme_epure{{/str}}</p>
        <div class="epure-a11yguide-actions d-print-none">
            <button type="button" class="btn btn-secondary" data-action="epure-a11yguide-print">
                <i class="fa fa-print" aria-hidden="true"></i> {{#str}}courseaccessibility_print, theme_epure{{/str}}
            </button>
            <a class="btn btn-secondary" href="{{checklisturl}}">
                <i class="fa fa-list-check" aria-hidden="true"></i> {{#str}}checklist_open, theme_epure{{/str}}
            </a>
        </div>
        {{#download}}<div class="epure-a11yguide-download d-print-none">{{{download}}}</div>{{/download}}
    </div>

    {{#hasfirst}}
        <section class="epure-a11yguide-first" aria-labelledby="epure-a11yguide-first">
            <h3 id="epure-a11yguide-first">{{#str}}courseaccessibility_first, theme_epure{{/str}}</h3>
            <p class="epure-a11yguide-help">{{#str}}courseaccessibility_first_help, theme_epure{{/str}}</p>
            <ol>
                {{#first}}
                    <li><a href="{{url}}">{{name}}</a> <span class="epure-a11yguide-first-section">· {{section}}</span>
                        {{#here}}<span class="epure-a11yguide-here">{{#str}}courseaccessibility_fixhere, theme_epure{{/str}}</span>{{/here}}</li>
                {{/first}}
            </ol>
            {{#morefirst}}<p class="epure-a11yguide-help">{{#str}}courseaccessibility_first_more, theme_epure{{/str}}</p>{{/morefirst}}
        </section>
    {{/hasfirst}}

    {{#hasfilter}}
        <fieldset class="epure-a11yguide-filter d-print-none" data-shown="{{filtershown}}">
            <legend>{{#str}}courseaccessibility_filter, theme_epure{{/str}}</legend>
            <div class="epure-a11yguide-filter-choices">
                {{#filters}}
                    <label class="epure-a11yguide-filter-choice">
                        <input type="radio" name="epure-a11yguide-filter" value="{{value}}" {{#checked}}checked{{/checked}}>
                        <span>{{label}}</span>
                    </label>
                {{/filters}}
            </div>
            <p class="epure-a11yguide-filter-status" role="status" data-region="epure-a11yguide-filter-status"></p>
        </fieldset>
    {{/hasfilter}}

    <form method="post" action="{{action}}" class="epure-a11yguide-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#sections}}
            <section class="epure-a11yguide-section" aria-labelledby="{{id}}">
                <h3 class="epure-a11yguide-section-name" id="{{id}}">{{name}}</h3>
                {{#parts}}
                    <article class="epure-a11yguide-part epure-a11yguide-is-{{state.class}}" id="{{id}}" tabindex="-1" aria-labelledby="{{id}}-name" data-levels="{{levels}}">
                        <div class="epure-a11yguide-part-head">
                            {{#icon}}<img class="epure-a11yguide-part-icon" src="{{icon}}" alt="">{{/icon}}
                            <h4 class="epure-a11yguide-part-name" id="{{id}}-name">{{name}}{{#type}} <span class="epure-a11yguide-part-type">· {{type}}</span>{{/type}}</h4>
                            <p class="epure-a11yguide-state"><i class="fa {{state.icon}}" aria-hidden="true"></i> {{state.text}}</p>
                        </div>
                        {{#hasissues}}
                            <ul class="epure-a11yguide-issues">
                                {{#issues}}<li><span class="epure-a11yguide-level epure-a11yguide-level-{{level}}">{{levellabel}}</span> <strong class="epure-a11yguide-cause">{{cause}}</strong>{{#advice}} {{advice}}{{/advice}}</li>{{/issues}}
                            </ul>
                        {{/hasissues}}
                        {{#hasplaces}}
                            <p class="epure-a11yguide-places-title">{{#str}}courseaccessibility_places, theme_epure{{/str}}</p>
                            <ul class="epure-a11yguide-places">
                                {{#places}}
                                    <li><span class="epure-a11yguide-place">{{label}}</span>{{{sep}}}<span class="epure-a11yguide-cause">{{issues}}</span> <a class="d-print-none" href="{{url}}" aria-label="{{linktext}}">{{#str}}courseaccessibility_editplace_short, theme_epure{{/str}}</a></li>
                                {{/places}}
                            </ul>
                        {{/hasplaces}}
                        {{#hasrename}}
                            <div class="epure-a11yguide-rename d-print-none">
                                {{#rename}}
                                    <label for="{{id}}">{{label}}</label>
                                    <input type="text" class="form-control" id="{{id}}" name="{{field}}[{{cmid}}]" value="{{value}}"{{#placeholder}} placeholder="{{.}}"{{/placeholder}} maxlength="255"{{#required}} required{{/required}} aria-describedby="{{id}}-help">
                                    <p class="epure-a11yguide-check-help" id="{{id}}-help">{{help}}</p>
                                {{/rename}}
                            </div>
                        {{/hasrename}}
                        {{#haswrite}}
                            <div class="epure-a11yguide-rename epure-a11yguide-write d-print-none">
                                {{#write}}
                                    <label for="{{id}}">{{label}}</label>
                                    <textarea class="form-control" id="{{id}}" name="instructions[{{cmid}}]" rows="5" aria-describedby="{{id}}-help"></textarea>
                                    <p class="epure-a11yguide-check-help" id="{{id}}-help">{{#str}}courseaccessibility_write_help, theme_epure{{/str}}</p>
                                {{/write}}
                            </div>
                        {{/haswrite}}
                        {{#hasaltimages}}
