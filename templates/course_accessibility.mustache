                                {{#fixurllinks}}
                                    <div class="epure-a11yguide-alt">
                                        <div class="epure-a11yguide-alt-fields">
                                            <label for="{{id}}">{{label}}</label>
                                            <input type="text" class="form-control" id="{{id}}" name="urltext[{{key}}]" maxlength="{{altmax}}" aria-describedby="{{id}}-help">
                                            <p class="epure-a11yguide-check-help" id="{{id}}-help">{{#str}}courseaccessibility_fix_urllinks_help, theme_epure{{/str}}</p>
                                        </div>
                                    </div>
                                {{/fixurllinks}}
                            </fieldset>
                        {{/hasfixurllinks}}
                        {{#hasfixheadings}}
