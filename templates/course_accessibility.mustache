                                <legend class="epure-a11yguide-checks-title">{{#str}}courseaccessibility_fix_imagelinks_title, theme_epure{{/str}}</legend>
                                {{#fiximagelinks}}
                                    <div class="epure-a11yguide-alt">
                                        {{#image}}<img class="epure-a11yguide-alt-preview" src="{{image}}" alt="">{{/image}}
