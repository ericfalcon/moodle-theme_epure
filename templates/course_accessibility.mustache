                                            </div>
                                            <p class="epure-a11yguide-check-help" id="{{id}}-help">{{#str}}courseaccessibility_alt_help, theme_epure{{/str}}</p>
                                        </div>
                                    </div>
                                {{/altimages}}
                            </fieldset>
                        {{/hasaltimages}}
                        {{#hasfixframes}}
