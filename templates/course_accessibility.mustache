                    </article>
                {{/parts}}
            </section>
        {{/sections}}
        {{#hasform}}
            <div class="epure-a11yguide-save d-print-none">
                <button type="submit" class="btn btn-primary">{{savelabel}}</button>
                <a class="btn btn-secondary" href="{{courseurl}}">{{#str}}cancel{{/str}}</a>
            </div>
        {{/hasform}}
    </form>
</div>
{{#js}}
    // The filter: only the parts with a mistake of this severity, or with points to confirm; a section without any
    // part left is hidden too. The number of parts shown is told.
    document.querySelectorAll('.epure-a11yguide-filter').forEach(function(filter) {
        var guide = filter.closest('.epure-a11yguide');
        var status = filter.querySelector('[data-region="epure-a11yguide-filter-status"]');
        filter.addEventListener('change', function() {
            var value = filter.querySelector('input:checked').value;
            var shown = 0;
            guide.querySelectorAll('.epure-a11yguide-part').forEach(function(part) {
                var levels = (part.getAttribute('data-levels') || '').split(' ');
                part.hidden = value !== '' && levels.indexOf(value) === -1;
                shown += part.hidden ? 0 : 1;
            });
            guide.querySelectorAll('.epure-a11yguide-section').forEach(function(section) {
                section.hidden = !section.querySelector('.epure-a11yguide-part:not([hidden])');
            });
            status.textContent = filter.getAttribute('data-shown').replace('{$a}', shown);
        });
    });
    document.querySelectorAll('[data-action="epure-a11yguide-print"]').forEach(function(button) {
        button.addEventListener('click', function() {
            window.print();
        });
    });
{{/js}}
