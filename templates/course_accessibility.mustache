                                        <div class="epure-a11yguide-alt-fields">
                                            <label for="{{id}}">{{label}}</label>
                                            <input type="text" class="form-control" id="{{id}}" name="alt[{{key}}]" maxlength="{{altmax}}" aria-describedby="{{id}}-help">
