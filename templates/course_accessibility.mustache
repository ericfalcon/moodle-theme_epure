                                            <label for="{{id}}">{{label}}</label>
                                            <input type="text" class="form-control" id="{{id}}" name="linkalt[{{key}}]" maxlength="{{altmax}}" aria-describedby="{{id}}-help">
                                            <p class="epure-a11yguide-check-help" id="{{id}}-help">{{#str}}courseaccessibility_fix_imagelinks_help, theme_epure{{/str}}</p>
                                        </div>
                                    </div>
                                {{/fiximagelinks}}
                            </fieldset>
                        {{/hasfiximagelinks}}
                        {{#hasfixtables}}
                            <fieldset class="epure-a11yguide-alts epure-a11yguide-fixes d-print-none">
                                <legend class="epure-a11yguide-checks-title">{{#str}}courseaccessibility_fix_tables_title, theme_epure{{/str}}</legend>
                                {{#fixtables}}
                                    <fieldset class="epure-a11yguide-check" aria-describedby="{{id}}-help">
                                        <legend class="epure-a11yguide-check-legend">{{label}}</legend>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="{{id}}-header" name="tablehead[{{key}}]" value="header">
                                            <label class="form-check-label" for="{{id}}-header">{{#str}}courseaccessibility_fix_tables_header, theme_epure{{/str}}</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="{{id}}-layout" name="tablehead[{{key}}]" value="layout">
                                            <label class="form-check-label" for="{{id}}-layout">{{#str}}courseaccessibility_fix_tables_layout, theme_epure{{/str}}</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" id="{{id}}-none" name="tablehead[{{key}}]" value="none" checked>
                                            <label class="form-check-label" for="{{id}}-none">{{#str}}courseaccessibility_fix_tables_none, theme_epure{{/str}}</label>
                                        </div>
                                        <p class="epure-a11yguide-check-help" id="{{id}}-help">{{#str}}courseaccessibility_fix_tables_help, theme_epure{{/str}}</p>
                                    </fieldset>
