{{!
    @template theme_epure/palette_live

    Live preview of the colours in the settings: a header, a course card, a button, a link and a progress bar, in
    light and dark modes, updated as the colours are typed (theme_epure/palette_live). The drawing is for the eyes;
    the swatches under it give each colour and its code to everyone.

    Example context (json):
    {
        "id": "epure-palette-live",
        "style": "--pl-light-brand: #D83A2B;",
        "sitename": "Campus",
        "swatches": "<p>Palette</p>"
    }
}}
<div class="epure-palette-live" id="{{id}}" style="{{style}}" data-region="palette-live">
    <p class="small text-muted mb-2">{{#str}}palettelive_desc, theme_epure{{/str}}</p>
    <div class="epure-pl-modes" aria-hidden="true">
        {{#modes}}
        <div class="epure-pl-mode epure-pl-{{mode}}">
            <div class="epure-pl-header">
                <span class="epure-pl-logo">{{sitename}}</span>
                <span class="epure-pl-nav">{{#str}}home{{/str}}</span>
                <span class="epure-pl-nav">{{#str}}mycourses{{/str}}</span>
            </div>
            <div class="epure-pl-body">
                <p class="epure-pl-modename">{{label}}</p>
                <div class="epure-pl-card">
                    <span class="epure-pl-badge">{{#str}}palettelive_category, theme_epure{{/str}}</span>
                    <span class="epure-pl-title">{{#str}}palettelive_course, theme_epure{{/str}}</span>
                    <span class="epure-pl-progress"><span></span></span>
                    <span class="epure-pl-actions">
                        <span class="epure-pl-button">{{#str}}continue{{/str}}</span>
                        <span class="epure-pl-link">{{#str}}palettelive_link, theme_epure{{/str}}</span>
                    </span>
                </div>
            </div>
        </div>
        {{/modes}}
    </div>
    <div class="epure-pl-swatches" data-region="swatches">{{{swatches}}}</div>
</div>
