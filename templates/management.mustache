{{!
    @template theme_epure/management

    Management dashboard of the platform: the indicators of the period compared with the period before, the courses
    most followed, how far the learners are in the courses that track their completion; of the whole platform or of an
    IOMAD company, with the list of the companies for those who see them all. The words say every figure;
    the bars repeat them for the eyes. Then the accessibility of the courses, as their guides read it at night: the
    average score, the courses and the categories with the lowest scores, and the score week by week.

    Example context (json):
    {
        "days": 30,
        "company": "Clinique du Parc",
        "haschoices": true,
        "url": "#",
        "choices": [{"value": 0, "name": "The whole platform", "selected": false},
            {"value": 1, "name": "Clinique du Parc", "selected": true}],
        "indicators": [{"key": "active", "label": "Users who logged in", "value": 42, "previous": 30,
            "change": "40 % more than the 30 days before (30)", "trend": "up", "icon": "fa-arrow-up"}],
        "hascourses": true,
        "courses": [{"name": "Safety at work", "url": "#", "enrolled": 20, "active": 12, "completed": 3}],
        "completion": {"total": 20, "totaltext": "20 enrolments in the courses that track completion:", "hasdata": true, "parts": [
            {"key": "completed", "text": "Completed: 5 (25 %)", "percent": 25},
            {"key": "progress", "text": "In progress: 10 (50 %)", "percent": 50},
            {"key": "notstarted", "text": "Not started: 5 (25 %)", "percent": 25}]},
        "nolog": false,
        "companyid": 0,
        "accessibility": {
            "hasdata": true, "score": 78, "scoretext": "Average score: 78 %",
            "coursestext": "12 courses read", "blockingtext": "Courses with a blocking mistake: 3",
            "levels": [{"level": "blocking", "text": "Blocking: 4"}, {"level": "serious", "text": "Serious: 9"},
                {"level": "minor", "text": "Minor: 2"}],
            "hascourses": true,
            "courses": [{"name": "Safety at work", "url": "#", "score": 45, "blocking": 2}],
            "hascategories": true,
            "categories": [{"name": "Health", "courses": 5, "score": 70, "blocking": 2}],
            "hasweeks": true, "change": "4 points more in 2 weeks",
            "weeks": [{"date": "16/11/26", "score": 78, "courses": 12}, {"date": "02/11/26", "score": 74, "courses": 12}],
            "computed": "Last read: Thursday, 19 November 2026, 2:14 AM",
            "categorychoices": [{"value": 0, "name": "All the categories", "selected": true},
                {"value": 2, "name": "Health", "selected": false}]
        }
    }
}}
<div class="epure-management">
    <h2>{{#str}}management, theme_epure{{/str}}{{#company}}<span class="epure-management-company">{{company}}</span>{{/company}}</h2>
    <p class="epure-management-intro">{{#company}}{{#str}}management_intro_company, theme_epure, {{days}}{{/str}}{{/company}}{{^company}}{{#str}}management_intro, theme_epure, {{days}}{{/str}}{{/company}}</p>
    {{#haschoices}}
    <form class="epure-management-choose" method="get" action="{{url}}">
        <label for="epure-management-companyid">{{#str}}management_show, theme_epure{{/str}}</label>
        <select class="form-select custom-select" id="epure-management-companyid" name="companyid">
            {{#choices}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/choices}}
        </select>
        <button type="submit" class="btn btn-secondary">{{#str}}management_go, theme_epure{{/str}}</button>
    </form>
    {{/haschoices}}

    <section class="epure-management-section" aria-labelledby="epure-management-period">
        <h3 id="epure-management-period">{{#str}}management_period, theme_epure, {{days}}{{/str}}</h3>
        <ul class="epure-management-indicators">
            {{#indicators}}
            <li class="epure-management-indicator epure-management-{{trend}}">
                <span class="epure-management-label">{{label}}</span>
                <span class="epure-management-value">{{value}}</span>
                <span class="epure-management-change">
                    <i class="icon fa {{icon}} fa-fw" aria-hidden="true"></i>{{change}}
                </span>
            </li>
            {{/indicators}}
        </ul>
        {{#nolog}}<p class="epure-management-note">{{#str}}management_nolog, theme_epure{{/str}}</p>{{/nolog}}
    </section>

    <section class="epure-management-section" aria-labelledby="epure-management-courses">
        <h3 id="epure-management-courses">{{#str}}management_courses, theme_epure{{/str}}</h3>
        {{#hascourses}}
        <div class="table-responsive">
            <table class="table generaltable epure-management-table">
                <caption class="sr-only visually-hidden">{{#str}}management_courses, theme_epure{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}course{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}management_enrolled, theme_epure{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}management_courseactive, theme_epure, {{days}}{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}management_coursecompleted, theme_epure, {{days}}{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#courses}}
                    <tr>
                        <th scope="row"><a href="{{url}}">{{name}}</a></th>
                        <td class="text-end">{{enrolled}}</td>
                        <td class="text-end">{{active}}</td>
                        <td class="text-end">{{completed}}</td>
                    </tr>
                    {{/courses}}
                </tbody>
            </table>
        </div>
        {{/hascourses}}
        {{^hascourses}}<p>{{#str}}management_nocourses, theme_epure{{/str}}</p>{{/hascourses}}
    </section>

    <section class="epure-management-section" aria-labelledby="epure-management-completion">
        <h3 id="epure-management-completion">{{#str}}management_completion, theme_epure{{/str}}</h3>
        {{#completion.hasdata}}
        <p>{{completion.totaltext}}</p>
        <div class="epure-management-bar" aria-hidden="true">
            {{#completion.parts}}<span class="epure-management-part-{{key}}" style="width: {{percent}}%"></span>{{/completion.parts}}
        </div>
        <ul class="epure-management-parts">
            {{#completion.parts}}
            <li><span class="epure-management-swatch epure-management-part-{{key}}" aria-hidden="true"></span>{{text}}</li>
            {{/completion.parts}}
        </ul>
        {{/completion.hasdata}}
        {{^completion.hasdata}}<p>{{#str}}management_completion_none, theme_epure{{/str}}</p>{{/completion.hasdata}}
    </section>
    {{#accessibility}}
    <section class="epure-management-section epure-a11yscores" aria-labelledby="epure-management-a11y">
        <h3 id="epure-management-a11y">{{#str}}a11yscores, theme_epure{{/str}}</h3>
        <form class="epure-management-choose" method="get" action="{{url}}">
            {{#companyid}}<input type="hidden" name="companyid" value="{{companyid}}">{{/companyid}}
            <label for="epure-a11yscores-categoryid">{{#str}}a11yscores_category, theme_epure{{/str}}</label>
            <select class="form-select custom-select" id="epure-a11yscores-categoryid" name="categoryid">
                {{#categorychoices}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/categorychoices}}
            </select>
            <button type="submit" class="btn btn-secondary">{{#str}}management_go, theme_epure{{/str}}</button>
        </form>
        {{#hasdata}}
        <div class="epure-a11yscores-summary">
            <p class="epure-a11yscores-score">{{scoretext}}</p>
            <div class="epure-management-bar" aria-hidden="true"><span class="epure-a11yscores-fill" style="width: {{score}}%"></span></div>
            <ul class="epure-a11yscores-figures">
                <li>{{coursestext}}</li>
                <li>{{blockingtext}}</li>
                {{#levels}}<li><span class="epure-a11y-pill epure-a11y-pill-{{level}}">{{text}}</span></li>{{/levels}}
            </ul>
            {{#change}}<p class="epure-a11yscores-change">{{change}}</p>{{/change}}
        </div>
        {{#hascourses}}
        <h4>{{#str}}a11yscores_lowest, theme_epure{{/str}}</h4>
        <div class="table-responsive">
            <table class="table generaltable epure-management-table">
                <caption class="sr-only visually-hidden">{{#str}}a11yscores_lowest, theme_epure{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}course{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}a11yscores_scorecol, theme_epure{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}courseaccessibility_level_blocking, theme_epure{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#courses}}
                    <tr>
                        <th scope="row"><a href="{{url}}">{{name}}</a></th>
                        <td class="text-end">{{score}} %</td>
                        <td class="text-end">{{blocking}}</td>
                    </tr>
                    {{/courses}}
                </tbody>
            </table>
        </div>
        {{/hascourses}}
        {{#hascategories}}
        <h4>{{#str}}a11yscores_categories, theme_epure{{/str}}</h4>
        <div class="table-responsive">
            <table class="table generaltable epure-management-table">
                <caption class="sr-only visually-hidden">{{#str}}a11yscores_categories, theme_epure{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}category{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}courses{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}a11yscores_scorecol, theme_epure{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}a11yscores_blockingcol, theme_epure{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#categories}}
                    <tr>
                        <th scope="row">{{name}}</th>
                        <td class="text-end">{{courses}}</td>
                        <td class="text-end">{{score}} %</td>
                        <td class="text-end">{{blocking}}</td>
                    </tr>
                    {{/categories}}
                </tbody>
            </table>
        </div>
        {{/hascategories}}
        {{#hasweeks}}
        <h4>{{#str}}a11yscores_weeks, theme_epure{{/str}}</h4>
        <div class="table-responsive">
            <table class="table generaltable epure-management-table epure-a11yscores-weeks">
                <caption class="sr-only visually-hidden">{{#str}}a11yscores_weeks, theme_epure{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}a11yscores_week, theme_epure{{/str}}</th>
                        <th scope="col">{{#str}}a11yscores_scorecol, theme_epure{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}a11yscores_coursescol, theme_epure{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#weeks}}
                    <tr>
                        <th scope="row">{{date}}</th>
                        <td>
                            <span class="epure-a11yscores-weekbar" aria-hidden="true"><span style="width: {{score}}%"></span></span>
                            {{score}} %
                        </td>
                        <td class="text-end">{{courses}}</td>
                    </tr>
                    {{/weeks}}
                </tbody>
            </table>
        </div>
        {{/hasweeks}}
        <p class="epure-management-note">{{computed}} {{#str}}a11yscores_how, theme_epure{{/str}}</p>
        {{/hasdata}}
        {{^hasdata}}<p>{{#str}}a11yscores_none, theme_epure{{/str}}</p>{{/hasdata}}
    </section>
    {{/accessibility}}
</div>
