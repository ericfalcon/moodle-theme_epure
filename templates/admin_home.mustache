{{!
    @template theme_epure/admin_home

    Home of the site administration: a card for each part (Users, Courses, Appearance…) with its common tasks.
    The title of a card leads to the whole part. Above them, until it is finished or dismissed, the getting started
    with Épure (setup: url, dismissurl), and what is new in Épure since the version installed before (whatsnew: title,
    notes with version and text, more, changesurl, dismissurl).

    Example context (json):
    {
        "setup": {"url": "#", "dismissurl": "#"},
        "cards": [
            {"name": "Users", "url": "#", "icon": "fa-users", "tasks": [{"name": "Browse list of users", "url": "#"}]}
        ]
    }
}}
{{#whatsnew}}
<section class="epure-admin-setup epure-whatsnew" aria-labelledby="epure-whatsnew-title">
    <span class="epure-admin-setup-icon" aria-hidden="true"><i class="fa fa-gift"></i></span>
    <div class="epure-admin-setup-body">
        <h2 class="epure-admin-setup-title" id="epure-whatsnew-title">{{title}}</h2>
        <ul class="epure-whatsnew-notes">
            {{#notes}}<li><strong>{{version}}</strong> – {{text}}</li>{{/notes}}
        </ul>
        <div class="epure-admin-setup-actions">
            <a class="btn btn-primary" href="{{dismissurl}}">{{#str}}whatsnew_read, theme_epure{{/str}}</a>
            <a class="btn btn-link" href="{{changesurl}}">{{#more}}{{#str}}whatsnew_more, theme_epure{{/str}}{{/more}}{{^more}}{{#str}}whatsnew_all, theme_epure{{/str}}{{/more}}</a>
        </div>
    </div>
</section>
{{/whatsnew}}
{{#setup}}
<section class="epure-admin-setup" aria-labelledby="epure-admin-setup-title">
    <span class="epure-admin-setup-icon" aria-hidden="true"><i class="fa fa-wand-magic-sparkles"></i></span>
    <div class="epure-admin-setup-body">
        <h2 class="epure-admin-setup-title" id="epure-admin-setup-title">{{#str}}setup, theme_epure{{/str}}</h2>
        <p>{{#str}}setup_offer, theme_epure{{/str}}</p>
        <div class="epure-admin-setup-actions">
            <a class="btn btn-primary" href="{{url}}">{{#str}}setup_start, theme_epure{{/str}}</a>
            <a class="btn btn-link" href="{{dismissurl}}">{{#str}}setup_dismiss, theme_epure{{/str}}</a>
        </div>
    </div>
</section>
{{/setup}}
<section class="epure-admin-home" aria-labelledby="epure-admin-home-title">
    <h2 class="epure-admin-home-title" id="epure-admin-home-title">{{#str}}adminhome, theme_epure{{/str}}</h2>
    <div class="epure-admin-home-cards">
        {{#cards}}
        <div class="epure-admin-card">
            <h3 class="epure-admin-card-title">
                <span class="epure-admin-card-icon" aria-hidden="true"><i class="fa {{icon}}"></i></span>
                <a href="{{url}}">{{name}}</a>
            </h3>
            <ul class="epure-admin-card-tasks">
                {{#tasks}}
                <li><a href="{{url}}">{{name}}</a></li>
                {{/tasks}}
            </ul>
        </div>
        {{/cards}}
    </div>
</section>
