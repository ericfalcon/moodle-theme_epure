{{!
    @template theme_epure/resource_text

    The text of the document of a resource, under the document shown in its page (theme_epure/resource_text): a button
    shows it or hides it; the text is written by the template theme_epure/document_text once asked for.

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<div class="epure-resource-text">
    <button type="button" class="btn btn-secondary" data-epure-textversion="1" data-state="pdf" aria-expanded="false" aria-controls="epure-resource-text">{{#str}}resourcetext_show, theme_epure{{/str}}</button>
    <div id="epure-resource-text" class="epure-resource-text-content" role="region" aria-label="{{#str}}resourcetext, theme_epure{{/str}}" hidden></div>
</div>
