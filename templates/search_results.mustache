{{!
    @template theme_epure/search_results

    All the results of a search in the courses of the user: the form of the query, a sentence with the counts (a live
    status), then the courses and the activities, the best first.

    Example context (json):
    {
        "action": "#", "query": "risk", "searched": true,
        "summary": "2 courses and 1 activity match “risk”.",
        "groups": [
            {"key": "mycourses", "label": "My courses", "count": 1,
                "items": [{"name": "Risks at work", "url": "#", "detail": "RISK", "icon": "fa-graduation-cap"}]},
            {"key": "activities", "label": "Activities", "count": 1,
                "items": [{"name": "Risks of fire", "url": "#", "detail": "Safety", "icon": "fa-file-lines"}]}
        ]
    }
}}
<div class="epure-searchresults">
    <form method="get" action="{{action}}" class="epure-searchresults-form" role="search">
        <label for="epure-searchresults-q">{{#str}}quicksearch_mine_label, theme_epure{{/str}}</label>
        <div class="epure-searchresults-field">
            <input type="search" id="epure-searchresults-q" name="q" class="form-control" value="{{query}}" required minlength="2"
                autocomplete="off">
            <button type="submit" class="btn btn-primary">{{#str}}search{{/str}}</button>
        </div>
    </form>
    {{#searched}}
        <p class="epure-searchresults-summary" role="status">{{#summary}}{{summary}}{{/summary}}{{^summary}}{{#str}}quicksearch_none, theme_epure, {{query}}{{/str}}{{/summary}}</p>
        {{#more}}<p class="epure-searchresults-detail">{{#str}}quicksearch_first, theme_epure, {{limit}}{{/str}}</p>{{/more}}
        {{#groups}}
            <section class="epure-searchresults-group" aria-labelledby="epure-searchresults-{{key}}">
                <h2 class="epure-searchresults-heading" id="epure-searchresults-{{key}}">{{label}} <span class="badge text-bg-secondary bg-secondary">{{count}}</span></h2>
                <ul class="epure-searchresults-list">
                    {{#items}}
                        <li>
                            {{#image}}<img src="{{image}}" alt="" class="epure-searchresults-icon">{{/image}}
                            {{#icon}}<i class="fa {{icon}} epure-searchresults-icon" aria-hidden="true"></i>{{/icon}}
                            <a href="{{url}}">{{name}}</a>
                            {{#detail}}<span class="epure-searchresults-detail">{{detail}}</span>{{/detail}}
                        </li>
                    {{/items}}
                </ul>
            </section>
        {{/groups}}
    {{/searched}}
</div>
