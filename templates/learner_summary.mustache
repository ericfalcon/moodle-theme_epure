{{!
    @template theme_epure/learner_summary

    « My summary »: what the platform recorded of a learner, on a page they print or save as PDF. The figures, then
    each course with its progress, its date of completion, its grade and the activities completed with their date,
    then the certificates, and a note on what the summary proves. Then the documents: the form to issue a PDF with a
    code of verification, saying what its recipient will see and for how long, and the documents issued, to revoke or
    delete.

    Example context (json):
    {
        "fullname": "Lea Learner", "date": "30/10/26", "taken": 2, "completedcount": 1, "certificatecount": 1,
        "hascourses": true, "courses": [
            {"name": "Safety at work", "url": "#", "category": "Training", "hasprogress": true, "progress": 100,
                "completed": true, "datecompleted": "12/10/26", "grade": "16.00 (80.00 %)", "hasactivities": true,
                "activities": [{"name": "Risks", "date": "02/10/26"}, {"name": "Final quiz", "date": "12/10/26"}]},
            {"name": "First aid", "url": "#", "category": "", "hasprogress": true, "progress": 40, "completed": false,
                "datecompleted": "", "grade": "", "hasactivities": false, "activities": []}
        ],
        "hascertificates": true, "certificates": [{"name": "Safety at work", "date": "12/10/26", "url": "#"}],
        "pdfaction": "#", "sesskey": "abc",
        "validity": [{"value": 90, "label": "3 months", "checked": false, "id": "v90"},
            {"value": 365, "label": "1 year", "checked": true, "id": "v365"},
            {"value": 0, "label": "Without limit", "checked": false, "id": "v0"}],
        "hasdocuments": true, "documents": [
            {"id": 1, "code": "ABCD-EFGH-JKMN", "issued": "30/10/26, 10:12", "until": "30 October 2027",
                "state": "Valid", "statekey": "valid", "canrevoke": true, "verifyurl": "#", "revokeurl": "#",
                "deleteurl": "#"}
        ]
    }
}}
<div class="epure-summary">
    <div class="epure-summary-head">
        <div>
            <p class="epure-summary-name">{{fullname}}</p>
            <p class="epure-summary-date">{{#str}}mysummary_date, theme_epure, {{date}}{{/str}}</p>
        </div>
        <div class="epure-summary-actions d-print-none">
            <a class="btn btn-primary" href="#epure-summary-documents">
                <i class="fa fa-file-pdf" aria-hidden="true"></i> {{#str}}mysummary_pdf, theme_epure{{/str}}
            </a>
            <button type="button" class="btn btn-outline-secondary" data-action="epure-summary-print">
                <i class="fa fa-print" aria-hidden="true"></i> {{#str}}mysummary_print, theme_epure{{/str}}
            </button>
        </div>
    </div>
    <p class="epure-summary-pdfnote d-print-none">{{#str}}mysummary_pdf_note, theme_epure{{/str}}</p>

    <dl class="epure-summary-figures">
        <div><dt>{{#str}}mysummary_taken, theme_epure{{/str}}</dt><dd>{{taken}}</dd></div>
        <div><dt>{{#str}}mysummary_completed, theme_epure{{/str}}</dt><dd>{{completedcount}}</dd></div>
        <div><dt>{{#str}}mysummary_certificates, theme_epure{{/str}}</dt><dd>{{certificatecount}}</dd></div>
    </dl>

    {{#hascourses}}
        <h2 class="epure-summary-heading">{{#str}}mysummary_taken, theme_epure{{/str}}</h2>
        {{#courses}}
            <section class="epure-summary-course">
                {{#category}}<p class="epure-summary-category">{{category}}</p>{{/category}}
                <h3 class="epure-summary-course-name"><a href="{{url}}">{{name}}</a></h3>
                <ul class="epure-summary-facts">
                    {{#hasprogress}}<li>{{#str}}mysummary_progress, theme_epure, {{progress}}{{/str}}</li>{{/hasprogress}}
                    {{#datecompleted}}<li>{{#str}}mysummary_completedon, theme_epure, {{datecompleted}}{{/str}}</li>{{/datecompleted}}
                    {{#grade}}<li>{{#str}}mysummary_grade, theme_epure, {{grade}}{{/str}}</li>{{/grade}}
                </ul>
                {{#hasactivities}}
                    <h4 class="epure-summary-subheading">{{#str}}mysummary_activities, theme_epure{{/str}}</h4>
                    <ul class="epure-summary-activities">
                        {{#activities}}<li><span>{{name}}</span><span class="epure-summary-activity-date">{{date}}</span></li>{{/activities}}
                    </ul>
                {{/hasactivities}}
            </section>
        {{/courses}}
    {{/hascourses}}
    {{^hascourses}}<p class="epure-summary-empty">{{#str}}mysummary_none, theme_epure{{/str}}</p>{{/hascourses}}

    {{#hascertificates}}
        <h2 class="epure-summary-heading">{{#str}}mysummary_certificates, theme_epure{{/str}}</h2>
        <ul class="epure-summary-activities">
            {{#certificates}}<li><a href="{{url}}">{{name}}</a><span class="epure-summary-activity-date">{{date}}</span></li>{{/certificates}}
        </ul>
    {{/hascertificates}}

    <p class="epure-summary-note">{{#str}}mysummary_note, theme_epure{{/str}}</p>

    <section class="epure-summary-documents d-print-none" id="epure-summary-documents" aria-labelledby="epure-summary-documents-heading">
        <h2 class="epure-summary-heading" id="epure-summary-documents-heading">{{#str}}mysummary_documents, theme_epure{{/str}}</h2>
        <form class="epure-summary-issue" method="get" action="{{pdfaction}}">
            <input type="hidden" name="format" value="pdf">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <p>{{#str}}mysummary_issue_intro, theme_epure{{/str}}</p>
            <ul class="epure-summary-shared">
                <li>{{#str}}mysummary_shared_identity, theme_epure{{/str}}</li>
                <li>{{#str}}mysummary_shared_courses, theme_epure{{/str}}</li>
                <li>{{#str}}mysummary_shared_grades, theme_epure{{/str}}</li>
                <li>{{#str}}mysummary_shared_certificates, theme_epure{{/str}}</li>
            </ul>
            <fieldset class="epure-summary-validity">
                <legend>{{#str}}mysummary_validity, theme_epure{{/str}}</legend>
                {{#validity}}
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="validity" id="{{id}}" value="{{value}}"{{#checked}} checked{{/checked}}>
                        <label class="form-check-label" for="{{id}}">{{label}}</label>
                    </div>
                {{/validity}}
            </fieldset>
            <p class="epure-summary-issue-note">{{#str}}mysummary_issue_control, theme_epure{{/str}}</p>
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-file-pdf" aria-hidden="true"></i> {{#str}}mysummary_pdf, theme_epure{{/str}}
            </button>
        </form>

        {{#hasdocuments}}
            <h3 class="epure-summary-subheading">{{#str}}mysummary_issued, theme_epure{{/str}}</h3>
            <div class="table-responsive">
                <table class="table epure-summary-issued">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}}mysummary_verify_code, theme_epure{{/str}}</th>
                            <th scope="col">{{#str}}mysummary_issuedon, theme_epure{{/str}}</th>
                            <th scope="col">{{#str}}mysummary_until, theme_epure{{/str}}</th>
                            <th scope="col">{{#str}}mysummary_state, theme_epure{{/str}}</th>
                            <th scope="col"><span class="visually-hidden sr-only">{{#str}}actions{{/str}}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#documents}}
                            <tr>
                                <th scope="row"><a href="{{verifyurl}}">{{code}}</a></th>
                                <td>{{issued}}</td>
                                <td>{{until}}</td>
                                <td><span class="epure-summary-state epure-summary-state-{{statekey}}">{{state}}</span></td>
                                <td>
                                    <div class="epure-summary-docactions">
                                    {{#canrevoke}}
                                        <a class="btn btn-sm btn-outline-secondary" href="{{revokeurl}}">{{#str}}mysummary_revoke, theme_epure{{/str}}<span class="visually-hidden sr-only"> {{code}}</span></a>
                                    {{/canrevoke}}
                                    <a class="btn btn-sm btn-outline-danger" href="{{deleteurl}}">{{#str}}mysummary_delete, theme_epure{{/str}}<span class="visually-hidden sr-only"> {{code}}</span></a>
                                    </div>
                                </td>
                            </tr>
                        {{/documents}}
                    </tbody>
                </table>
            </div>
        {{/hasdocuments}}
    </section>
</div>
{{#js}}
    document.querySelectorAll('[data-action="epure-summary-print"]').forEach(function(button) {
        button.addEventListener('click', function() {
            window.print();
        });
    });
{{/js}}
