{{!
    @template theme_epure/checklist

    Reminder « Making my courses accessible »: the points to check, by theme, each with a box to tick by hand on paper.
    A star marks those the guide of a course finds without a person.

    Example context (json):
    {
        "back": {"url": "#", "text": "Back to the accessibility of « Safety at work »"},
        "themes": [{"title": "Texts", "items": [
            {"id": "epure-checklist-headings", "text": "The titles follow in order (title 2, then 3).", "auto": true},
            {"id": "epure-checklist-instructions", "text": "The instructions say what to do, how and by when.", "auto": false}
        ]}]
    }
}}
<div class="epure-checklist">
    {{#back}}
        <p class="epure-checklist-back d-print-none"><a href="{{url}}"><i class="fa fa-arrow-left" aria-hidden="true"></i> {{text}}</a></p>
    {{/back}}
    <p class="epure-checklist-intro">{{#str}}checklist_intro, theme_epure{{/str}}</p>
    <div class="epure-checklist-actions d-print-none">
        <button type="button" class="btn btn-primary" data-action="epure-checklist-print">
            <i class="fa fa-print" aria-hidden="true"></i> {{#str}}checklist_print, theme_epure{{/str}}
        </button>
    </div>
    <div class="epure-checklist-themes">
        {{#themes}}
            <section class="epure-checklist-theme">
                <h2 class="epure-checklist-title">{{title}}</h2>
                <ul class="epure-checklist-items">
                    {{#items}}
                        <li class="epure-checklist-item">
                            <span class="epure-checklist-box" aria-hidden="true"></span>
                            <span>{{text}}{{#auto}} <span class="epure-checklist-auto"><span aria-hidden="true">★</span><span class="sr-only visually-hidden">{{#str}}checklist_auto_short, theme_epure{{/str}}</span></span>{{/auto}}</span>
                        </li>
                    {{/items}}
                </ul>
            </section>
        {{/themes}}
    </div>
    <p class="epure-checklist-legend"><span aria-hidden="true">★ </span>{{#str}}checklist_auto, theme_epure{{/str}}</p>
</div>
{{#js}}
    document.querySelectorAll('[data-action="epure-checklist-print"]').forEach(function(button) {
        button.addEventListener('click', function() {
            window.print();
        });
    });
{{/js}}
